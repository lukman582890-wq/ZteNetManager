<Window x:Class="ZteNetManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZTE Network Manager" Height="720" Width="1180" MinHeight="600" MinWidth="950" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#101827"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="ZTE" Foreground="#22D3EE" FontSize="30" FontWeight="Bold"/><TextBlock Text="NETWORK MANAGER" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,28"/><Button Content="Dashboard" HorizontalContentAlignment="Left" Click="Dashboard_Click"/><Button Content="Devices" HorizontalContentAlignment="Left" Click="Scan_Click"/><Button Content="Router diagnostics" HorizontalContentAlignment="Left" Click="Router_Click"/><Button Content="Access control" HorizontalContentAlignment="Left" Click="Access_Click"/><Button Content="Settings" HorizontalContentAlignment="Left" Click="Settings_Click"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="ZTE F6201B • Local network" Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/></DockPanel></Border>
  <Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,20"><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock x:Name="Subtitle" Text="Monitor perangkat di jaringan lokal Anda" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Buka Admin Router" Margin="0,0,8,0" Click="OpenRouterAdmin_Click"/><Button Content="Scan now" Background="{StaticResource AccentBrush}" Foreground="White" Click="Scan_Click"/></StackPanel></DockPanel>
   <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18"><Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="Perangkat terdeteksi" Foreground="#64748B"/><TextBlock x:Name="DeviceCount" Text="—" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="Gateway modem" Foreground="#64748B"/><TextBlock x:Name="GatewayText" Text="Mendeteksi..." FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Router adapter" Foreground="#64748B"/><TextBlock Text="Belum diverifikasi" FontSize="18" FontWeight="SemiBold" Foreground="#B45309" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
   <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Perangkat pada jaringan lokal" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Nama perangkat" Binding="{Binding DisplayName}" Width="2*"/><DataGridTextColumn Header="IPv4" Binding="{Binding IPv4}" Width="*"/><DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="1.5*"/><DataGridTextColumn Header="Sumber" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
   <TextBlock Grid.Row="3" x:Name="StatusText" Text="Siap. Pemblokiran otomatis nonaktif sampai integrasi firmware diverifikasi." Foreground="#64748B" Margin="0,14,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
